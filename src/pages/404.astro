---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/ubuntu/400.css';
import '@fontsource-variable/arima';
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Seite nicht gefunden – Patricia Bachmann</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/images/68f693e4a34b49b0779b4f31_favicon-32x32.png" type="image/png" />
  <script defer data-domain="patricia-bachmann.de" src="https://plausible.polizen.app/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"></script>
  <script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
</head>
<body>
  <Nav />
  <main class="not-found">
    <div class="not-found__inner">
      <img
        src="/images/68ecf4cfddadf85c6868f082_gopher-autmn.avif"
        alt="Gopher Maskottchen"
        class="not-found__gopher"
        loading="lazy"
      />
      <p class="not-found__code">404</p>
      <h1 class="not-found__heading">Seite nicht gefunden</h1>
      <p class="not-found__sub">Diese Seite existiert leider nicht – aber unsere Kindergartenfotos schon!</p>
      <a href="/" class="not-found__btn">Zurück zur Startseite</a>
    </div>
  </main>
  <Footer />
</body>
</html>

<style>
.not-found {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  padding: var(--pad-x);
}
.not-found__inner {
  text-align: center;
  max-width: 480px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
.not-found__gopher { width: 10rem; }
.not-found__code {
  font-family: var(--font-heading);
  font-size: 6rem;
  font-weight: 300;
  color: var(--color-border);
  line-height: 1;
}
.not-found__heading {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 400;
}
.not-found__sub { color: var(--color-text-mid); }
.not-found__btn {
  display: inline-block;
  background: var(--color-glacier);
  border: 1px solid var(--color-glacier-dark);
  color: var(--color-text);
  font-family: var(--font-body);
  font-weight: 500;
  padding: 0.875rem 2rem;
  border-radius: 10px;
  text-decoration: none;
  margin-top: 0.5rem;
  transition: background-color 0.2s;
}
.not-found__btn:hover { background: var(--color-glacier-dark); color: #fff; }
</style>
