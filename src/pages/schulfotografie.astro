---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import FAQ from '../components/FAQ.astro';
import Photo from '../components/Photo.astro';
import '../styles/global.css';
import '@fontsource/ubuntu/400.css';
import '@fontsource/ubuntu/500.css';
import '@fontsource/ubuntu/700.css';
import '@fontsource-variable/arima';

const testimonials = [
  {
    name: 'Stefanie Weinmann',
    role: 'Lehrerin',
    quote: 'Patricia hat unglaubliche Arbeit geleistet. Innerhalb von 2 Tagen hat sie 60 Kinder fotografiert. Das Ergebnis war super.',
    avatar: '/images/testimonials/68f10de1bec0cef973370b7f_stefanie-weinmann-google-bild.png',
    rating: 5,
  },
  {
    name: 'Verena Schneider',
    role: 'Kindergartenleiterin',
    quote: 'Einfach wunderschöne Fotos und ein liebevoller Umgang mit den Kindern! Vielen Dank ❤️❤️❤️',
    avatar: '/images/testimonials/68f0ed8cb62e9a388777ee99_verena-schneider-image.png',
    rating: 5,
  },
  {
    name: 'Lena Braun',
    role: 'Erzieherin',
    quote: 'Patricia hat wunderschöne Bilder von den Kindern gemacht – man sieht direkt dass so viel Liebe im Detail steckt.',
    avatar: '/images/testimonials/68f0ed4e2c9e5f3d70664147_lena-braun.png',
    rating: 5,
  },
  {
    name: 'Mia Kächelin',
    role: 'Mutter',
    quote: 'Wir sind einfach begeistert! Patricia ist eine unglaublich liebevolle und einfühlsame Fotografin – genau das, was man sich für Kinderfotos wünscht.',
    avatar: '/images/testimonials/68f0eb41d86cfd97ef28bd27_unnamed.png',
    rating: 5,
  },
  {
    name: 'Julia Hahn',
    role: 'Mutter',
    quote: 'Wunderschöne natürliche Bilder meiner Kinder. Sehr empfehlenswert!',
    avatar: '/images/testimonials/68f10ea57cb99c7f7619b756_julia-hahn-image.png',
    rating: 5,
  },
  {
    name: 'Jessica Beier',
    role: 'Erzieherin',
    quote: 'Patricia ist mega lieb und die Kinder haben sie sofort ins Herz geschlossen. Tolle Bilder!',
    avatar: '/images/testimonials/68f10e6b39e9add4d0199e29_jessica-beier-image.png',
    rating: 5,
  },
  {
    name: 'Sunny Rose',
    role: 'Mutter',
    quote: 'Super nette Fotografin, die Kinder hatten viel Spaß und die Bilder sind wunderschön!',
    avatar: '/images/testimonials/68f0ecd8cba6bac20da4b94a_sunny-rose-image.png',
    rating: 5,
  },
  {
    name: 'Franca Blauss',
    role: 'Mutter',
    quote: 'Liebevolle Fotografin mit tollem Auge für Details. Die Bilder unserer Kinder sind einfach wunderschön!',
    avatar: '/images/testimonials/68f0edbadcfb6794271b7730_Franca-blauss-image.png',
    rating: 5,
  },
];

const faqs = [
  { question: 'Sind die Bilder DSGVO konform?', answer: 'Ja. Alle Bilder werden in Deutschland gehostet. Ich arbeite über die Plattform Fotograf.de mit Firmensitz in Berlin. Sie bieten sichere Bezahlmethoden, sicheren Download und schnelle Verarbeitung.' },
  { question: 'Dauern die Fotos lang?', answer: 'Aufgrund der Reife der Kinder und des Verständnisses gehen Schulbilder deutlich schneller als Kindergartenbilder. Deshalb kann ich an Schulen auch deutlich mehr Kinder an einem Tag fotografieren.' },
  { question: 'Was kostet ein Shooting?', answer: 'Das Shooting ist ohne Kosten für die Schule und zunächst auch ohne Kosten für die Eltern. Vorab ist kein Geld zu entrichten. Die Eltern können im Nachgang die Bilder online einsehen und einzeln oder über Pakete bestellen.' },
  { question: 'Wann werden die Fotos geliefert?', answer: 'In aller Regel dauert die Bearbeitung ein bis zwei Wochen. Dann sind die Bilder als Upload im Onlineportal verfügbar und die Eltern bekommen via E-Mail eine Erinnerung.' },
  { question: 'Müssen Lehrer oder die Schule etwas vorbereiten?', answer: 'In aller Regel bringe ich alles mit. Es ist aber nie von Nachteil, wenn die Schüler entsprechend vorbereitet werden und das Ganze durch eine Begleitperson organisiert wird.' },
];

const heroImages = [
  '68fdf8f5c5066938e747a02a_photo-2025-10-22-10-27-55-2.avif',
  '68fdf8f5eb82e8017099a60c_PHOTO-2025-10-22-10-27-54-2.avif',
  '68fdf8f5e79a1b8bcd591a8e_PHOTO-2025-10-22-10-27-56-3.avif',
  '68fdf8f565e23b84dc4d427e_PHOTO-2025-10-22-10-27-55.avif',
  '68fdf8f5309d6ced6a86a9ec_photo-2025-10-22-10-27-55-3.avif',
  '68fdf8f5c4cb7cec3af1423c_photo-2025-10-22-10-27-56-4.avif',
  '68fdf8f5e6a825faf56b694b_PHOTO-2025-10-22-10-27-54.avif',
  '68f68f4ae1996d2c9ea33683_Vavrova-Photography-116-von-250.avif',
];
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Schulfotografin Göppingen – Natürliche Schulfotos | Patricia Bachmann</title>
  <meta name="description" content="Kindgerechte Schulfotografie im Raum Göppingen. Schnelle Abläufe, DSGVO-konform, online bestellbar. Jetzt Verfügbarkeit anfragen!" />
  <link rel="canonical" href="https://www.patricia-bachmann.de/schulfotografie" />
  <meta name="robots" content="index, follow" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.patricia-bachmann.de/schulfotografie" />
  <meta property="og:title" content="Schulfotografin Göppingen – Patricia Bachmann" />
  <meta property="og:description" content="Kindgerechte Schulfotografie im Raum Göppingen. Schnelle Abläufe, DSGVO-konform, online bestellbar." />
  <meta property="og:image" content="https://www.patricia-bachmann.de/images/og-image.jpg" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Patricia Bachmann Kindergartenfotografie" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Schulfotografin Göppingen – Patricia Bachmann" />
  <meta name="twitter:description" content="Kindgerechte Schulfotografie im Raum Göppingen. Schnelle Abläufe, DSGVO-konform, online bestellbar." />
  <meta name="twitter:image" content="https://www.patricia-bachmann.de/images/og-image.jpg" />
  <link rel="icon" href="/images/68f693e4a34b49b0779b4f31_favicon-32x32.png" type="image/png" />
  <link rel="apple-touch-icon" href="/images/68f6942db4d0e09d8a747738_webclip-patricia-bachmann.png" />
  <!-- Schema: Service -->
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://www.patricia-bachmann.de/schulfotografie#service",
    "name": "Schulfotografie",
    "serviceType": "Schulfotografie",
    "description": "Kindgerechte Schulfotos für Grundschulen in Göppingen, Stuttgart, Ulm und Umgebung.",
    "provider": { "@type": "LocalBusiness", "@id": "https://www.patricia-bachmann.de/#business", "name": "Patricia Bachmann Kindergartenfotografie" },
    "areaServed": [
      {"@type": "City", "name": "Göppingen"},
      {"@type": "City", "name": "Stuttgart"},
      {"@type": "City", "name": "Ulm"},
      {"@type": "City", "name": "Esslingen am Neckar"},
      {"@type": "City", "name": "Kirchheim unter Teck"},
      {"@type": "City", "name": "Geislingen an der Steige"},
      {"@type": "City", "name": "Schwäbisch Gmünd"}
    ],
    "hasOfferCatalog": { "@type": "OfferCatalog", "name": "Schulfotografie Pakete", "url": "https://www.patricia-bachmann.de/pakete" }
  })}</script>
  <!-- Schema: FAQPage -->
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Sind die Bilder DSGVO konform?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Alle Bilder werden in Deutschland gehostet. Ich arbeite über die Plattform Fotograf.de mit Firmensitz in Berlin. Sie bieten sichere Bezahlmethoden, sicheren Download und schnelle Verarbeitung." } },
      { "@type": "Question", "name": "Dauern die Fotos lang?", "acceptedAnswer": { "@type": "Answer", "text": "Aufgrund der Reife der Kinder gehen Schulbilder deutlich schneller als Kindergartenbilder. Deshalb kann ich an Schulen auch deutlich mehr Kinder an einem Tag fotografieren." } },
      { "@type": "Question", "name": "Was kostet ein Shooting?", "acceptedAnswer": { "@type": "Answer", "text": "Das Shooting ist ohne Kosten für die Schule und zunächst auch ohne Kosten für die Eltern. Vorab ist kein Geld zu entrichten. Die Eltern können im Nachgang die Bilder online einsehen und einzeln oder über Pakete bestellen." } },
      { "@type": "Question", "name": "Wann werden die Fotos geliefert?", "acceptedAnswer": { "@type": "Answer", "text": "In aller Regel dauert die Bearbeitung ein bis zwei Wochen. Dann sind die Bilder im Onlineportal verfügbar und die Eltern bekommen via E-Mail eine Erinnerung." } },
      { "@type": "Question", "name": "Müssen Lehrer oder die Schule etwas vorbereiten?", "acceptedAnswer": { "@type": "Answer", "text": "In aller Regel bringe ich alles mit. Es ist aber nie von Nachteil, wenn die Schüler entsprechend vorbereitet werden und das Ganze durch eine Begleitperson organisiert wird." } }
    ]
  })}</script>
  <script defer data-domain="patricia-bachmann.de" src="https://plausible.polizen.app/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"></script>
  <script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
</head>
<body>
  <Nav />

  <!-- ── Hero ── -->
  <div class="hero-section">
    <div class="startseite_hero-header-sektion_component">
      <!-- Text-Block -->
      <div class="hero-text-block padding-global">
        <div class="max-width-large">
          <div class="eyebrow margin-bottom margin-xsmall scroll-reveal">
            <div class="eyebrow-bg"></div>
            <p class="text-style-tagline">Schulfotografie</p>
          </div>
          <h1 class="heading-style-h1 scroll-reveal">Schulfotografin Göppingen</h1>
          <p class="hero-sub scroll-reveal">Hi, ich heiße Patricia und fotografiere Schulkinder ab der ersten Klasse.</p>
          <div class="button-group is-center scroll-reveal">
            <a href="/kontakt" class="button">
              <div class="button--content">
                <span>Verfügbarkeit Anfragen</span>
                <img src="/images/68eb6c8d50f03f9535e61da3_patricia-bachman-kindergartenfotografie-goeppingen.avif" alt="" class="button--image" />
              </div>
            </a>
            <a href="/pakete" class="button is-link">
              <span>Pakete &amp; Preise</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Bilder + Gopher -->
      <div class="gopher-wrapper">
        <img src="/images/gopher-schule-schultuete.avif" alt="" class="gopher" loading="eager" aria-hidden="true" />
        <div class="startseite_hero-header-sektion_images-layout">
          <!-- Reihe 1 (scrollt links) -->
          <div class="startseite_hero-header-sektion_image-list-top" id="hero-grid-top">
            {[0, 1].map((copy) => (
              <div class="startseite_hero-header-sektion_image-list">
                {heroImages.slice(0, 4).map((img, i) => (
                  <div class="startseite_hero-header-sektion_image-wrapper">
                    <Photo src={img} alt="Schulfotografie Göppingen – natürliches Schulfoto" class="startseite_hero-header-sektion_image" fetchpriority={copy === 0 && i === 0 ? 'high' : undefined} loading={copy === 0 && i === 0 ? 'eager' : 'lazy'} />
                  </div>
                ))}
              </div>
            ))}
          </div>
          <!-- Reihe 2 (scrollt rechts) -->
          <div class="startseite_hero-header-sektion_image-list-bottom" id="hero-grid-bottom">
            {[0, 1].map(() => (
              <div class="startseite_hero-header-sektion_image-list">
                {heroImages.slice(4, 8).map((img) => (
                  <div class="startseite_hero-header-sektion_image-wrapper">
                    <Photo src={img} alt="Schulfotografie Göppingen – Schülerporträt beim Fototag" class="startseite_hero-header-sektion_image" loading="lazy" />
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Über uns / USPs ── -->
  <section class="section_kindergartenfotografie_uber-uns-sektion padding-section-large">
    <div class="section-cloud-top is-flipped" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 1797 332" fill="none" class="cloud-svg"><ellipse cx="220.364" cy="162.12" rx="60.3546" ry="50.9812" fill="currentColor"/><ellipse cx="280.719" cy="157.557" rx="60.3546" ry="71.334" fill="currentColor"/><ellipse cx="366.286" cy="162.12" rx="60.3546" ry="50.9812" fill="currentColor"/><ellipse cx="401.428" cy="191.566" rx="60.3546" ry="50.9812" fill="currentColor"/><ellipse cx="451.173" cy="159.247" rx="84.8875" ry="69.6439" fill="currentColor"/><ellipse cx="559.432" cy="167.512" rx="72.4365" ry="75.0354" fill="currentColor"/><ellipse cx="633.71" cy="152.789" rx="72.4365" ry="60.3126" fill="currentColor"/><ellipse cx="473.865" cy="219.56" rx="72.4365" ry="60.3126" fill="currentColor"/><ellipse cx="723.992" cy="182.235" rx="92.1234" ry="60.3126" fill="currentColor"/><ellipse cx="823.483" cy="184.434" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="833.412" cy="111.139" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="908.238" cy="115.398" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="915.606" cy="220.286" rx="92.1234" ry="83.3523" fill="currentColor"/><ellipse cx="1201.96" cy="269.533" rx="63.5919" ry="56.4319" fill="currentColor"/><ellipse cx="1206.73" cy="173.077" rx="123.562" ry="96.4562" fill="currentColor"/><ellipse cx="1350.86" cy="176.232" rx="123.562" ry="103.641" fill="currentColor"/><path d="M1552.65 128.807C1552.65 169.31 1514.32 202.145 1467.04 202.145C1419.75 202.145 1381.42 169.31 1381.42 128.807C1381.42 88.303 1419.75 55.4684 1467.04 55.4684C1514.32 55.4684 1552.65 88.303 1552.65 128.807Z" fill="currentColor"/><ellipse cx="1498.72" cy="257.772" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="1578.2" cy="196.195" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="1593.17" cy="136.934" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="1631.68" cy="242.547" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="1007.73" cy="136.934" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="1063.54" cy="76.621" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="1138.37" cy="205.596" rx="92.1234" ry="83.6737" fill="currentColor"/><ellipse cx="1063.54" cy="213.102" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="706.147" cy="140.585" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="584.083" cy="76.621" rx="70.8567" ry="76.168" fill="currentColor"/><ellipse cx="443.938" cy="115.398" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="334.754" cy="106.067" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="213.808" cy="76.621" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="135.534" cy="182.235" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="1710.61" cy="146.948" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="92.8766" cy="96.9092" rx="92.1234" ry="76.168" fill="currentColor"/></svg></div>
    <div class="padding-global">
      <div class="container-large">
        <div class="kita-uber-uns__content">
          <div class="kindergartenfotografie_uber-uns-sektion_content-left">
            <div class="eyebrow margin-bottom margin-xsmall scroll-reveal">
              <div class="eyebrow-bg"></div>
              <p class="text-style-tagline">Über mich</p>
            </div>
            <h2 class="heading-style-h2 scroll-reveal">Schulbilder neu gedacht</h2>
            <p class="uber-sub scroll-reveal">Schöne Set-Ups – Schnelle Bildbearbeitung</p>
            <p class="uber-text scroll-reveal">
              Schluss mit langweiligen grauen Hintergründen. Schöne Set-Ups treffen den Stil
              der Kinder und machen Schulbilder zu etwas, worauf sich Kinder und Eltern freuen.
            </p>
            <div class="kindergartenfotografie_uber-uns-sektion_item-list">
              {[
                { title: 'Datenschutzkonform', text: 'Alle Daten und Bilder werden sicher und DSGVO-konform über Fotograf.de verarbeitet.' },
                { title: 'Schnelle Bildbearbeitung', text: 'Schulbilder sind in der Regel innerhalb 1–2 Wochen im Onlineportal verfügbar.' },
                { title: 'Onlineportal / Sichere Bezahlung', text: 'Eltern können Bilder selbst einsehen und über verschiedene Pakete bestellen.' },
              ].map(item => (
                <div class="kindergartenfotografie_uber-uns-sektion_item scroll-reveal">
                  <div class="kindergartenfotografie_uber-uns-sektion_item-icon-wrapper">
                    <span class="usp-check">✓</span>
                  </div>
                  <div class="kindergartenfotografie_uber-uns-sektion_item-text-wrapper">
                    <h4 class="heading-style-h6">{item.title}</h4>
                    <p>{item.text}</p>
                  </div>
                </div>
              ))}
            </div>
            <a href="/pakete" class="button is-link scroll-reveal" style="margin-top:1.5rem;">Mehr zum Prozess →</a>
          </div>
          <div class="kindergartenfotografie_uber-uns-sektion_image-wrapper scroll-reveal">
            <Photo
              src="68f68f4afaf2bd81bdb18c89_Vavrova-Photography-105-von-250.avif"
              alt="Schulfotografie – moderne Schulporträts in Göppingen"
              class="uber-uns-image"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Fotograf.de Screenshot -->
        <div class="platform-screenshot scroll-reveal">
          <img
            src="/images/69020e06441ace3302f9a66f_bildschirmfoto-2025-10-19-um-09-29-54.avif"
            alt="Fotograf.de Kundenportal – Sichere Bildbestellung"
            class="platform-img"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Zeitleiste / Ablauf ── -->
  <section class="section_kindergartenfotografie_zeitleiste-sektion padding-section-large">
    <div class="padding-global">
      <div class="container-large">
        <div class="eyebrow margin-bottom margin-xsmall scroll-reveal">
          <div class="eyebrow-bg"></div>
          <p class="text-style-tagline">Ablauf</p>
        </div>
        <h2 class="heading-style-h2 scroll-reveal">Wie komme ich in eure Schule?</h2>
        <div class="zeitleiste-grid">
          {[
            {
              n: '1',
              title: 'Schulleitung informieren',
              text: 'Ihr als Eltern könnt die Schulleitung darüber informieren, dass ihr eine Schulfotografin gefunden habt. So kommt der erste Kontakt zustande.',
              img: '68fdf8f5309d6ced6a86a9ec_photo-2025-10-22-10-27-55-3.avif',
            },
            {
              n: '2',
              title: 'Verfügbarkeit klären',
              text: 'Mit der Schulleitung kläre ich dann die Termine und Verfügbarkeiten ab. Außerdem bespreche ich den genauen Ablauf am Fototag.',
              img: '68fdf8f5c4cb7cec3af1423c_photo-2025-10-22-10-27-56-4.avif',
            },
            {
              n: '3',
              title: 'Fototag',
              text: 'Morgens baue ich das Set-Up auf. Die Schüler sind aufgrund ihrer Reife deutlich schneller zu fotografieren – so schaffe ich an Schulen auch deutlich mehr Kinder.',
              img: '68fdf8f5e6a825faf56b694b_PHOTO-2025-10-22-10-27-54.avif',
            },
          ].map(step => (
            <div class="zeitleiste-item scroll-reveal">
              <div class="zeitleiste-image-wrapper">
                <Photo src={step.img} alt={`Schulfotografie Göppingen – ${step.title}`} class="zeitleiste-image" loading="lazy" />
              </div>
              <div class="zeitleiste-text">
                <span class="zeitleiste-num">{step.n}</span>
                <h3 class="heading-style-h5">{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Testimonials ── -->
  <section class="section_kindergartenfotografie_testimonial padding-section-large">
    <div class="padding-global">
      <div class="container-large">
        <div class="kita-testi-header">
          <div>
            <div class="eyebrow margin-bottom margin-xsmall scroll-reveal">
              <div class="eyebrow-bg"></div>
              <p class="text-style-tagline">Bewertungen</p>
            </div>
            <h2 class="heading-style-h2 scroll-reveal">Schul- &amp; Elternfeedback</h2>
            <p class="scroll-reveal">Das sagen Schulen, Kindergärten und Eltern über die Google-Bewertungen zu meiner Arbeit.</p>
          </div>
          <a href="/kontakt" class="button scroll-reveal">
            <div class="button--content">
              <span>Verfügbarkeit anfragen</span>
              <img src="/images/68eb6c8d50f03f9535e61da3_patricia-bachman-kindergartenfotografie-goeppingen.avif" alt="" class="button--image" />
            </div>
          </a>
        </div>
        <div class="kita-testi-grid">
          {testimonials.map(t => (
            <div class="kita-testi-card scroll-reveal">
              <div class="kita-testi-stars">{'★'.repeat(t.rating)}</div>
              <p class="kita-testi-quote">"{t.quote}"</p>
              <div class="kita-testi-client">
                <img src={t.avatar} alt={t.name} class="kita-testi-avatar" loading="lazy" />
                <div>
                  <strong>{t.name}</strong>
                  <span>{t.role}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
