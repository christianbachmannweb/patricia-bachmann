<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

gsap.utils.toArray<HTMLElement>('.scroll-reveal').forEach(el => {
  gsap.from(el, {
    opacity: 0, y: 28, duration: 0.75, ease: 'power3.out',
    scrollTrigger: { trigger: el, start: 'top 88%' },
  });
});

// Hero-Marquee (wie Startseite): Reihe 1 nach links, Reihe 2 nach rechts
const heroTop = document.getElementById('hero-grid-top') as HTMLElement | null;
const heroBottom = document.getElementById('hero-grid-bottom') as HTMLElement | null;
if (heroTop) gsap.to(heroTop, { x: () => -(heroTop.scrollWidth / 2), duration: 35, ease: 'none', repeat: -1 });
if (heroBottom) gsap.fromTo(heroBottom, { x: () => -(heroBottom.scrollWidth / 2) }, { x: 0, duration: 30, ease: 'none', repeat: -1 });
</script>
