---
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getEinrichtungen, getBildUrl } from '../../lib/pocketbase';
import type { Einrichtung } from '../../lib/pocketbase';
import { isEinrichtungIndexable } from '../../data/einrichtungen';
import '../../styles/global.css';
import '@fontsource/ubuntu/400.css';
import '@fontsource/ubuntu/500.css';
import '@fontsource-variable/arima';

export async function getStaticPaths() {
  const einrichtungen = await getEinrichtungen();
  return einrichtungen.map((e) => ({
    params: { slug: e.slug },
    props: { einrichtung: e },
  }));
}

interface Props { einrichtung: Einrichtung; }
const { einrichtung: e } = Astro.props;

const isKita = e.typ === 'kita';
const title = e.seo_title || `${isKita ? 'Kindergartenfotografie' : 'Schulfotografie'} ${e.name} | Patricia Bachmann`;
const description = e.seo_description || `Natürliche ${isKita ? 'Kindergarten' : 'Schul'}fotos bei ${e.name} in ${e.ort} von Patricia Bachmann.`;
const canonical = `https://www.patricia-bachmann.de/kindergartenfotografie/${e.slug}`;
const mapsUrl = `https://maps.google.com/?q=${encodeURIComponent(e.name + ', ' + e.ort)}`;
const robots = isEinrichtungIndexable(e) ? 'index, follow' : 'noindex, follow';

const bilderList = Array.isArray(e.bilder) ? e.bilder.filter(Boolean) : [];

// Platzhalterbilder solange keine echten Fotos hochgeladen sind
const placeholders = [
  '/images/68f68f4a2cb959ad0eeeaa3b_Vavrova-Photography-6-von-132.avif',
  '/images/68f5d97ee5fc6b9192115130_Vavrova-Photography-1.avif',
  '/images/68f68f4afaf2bd81bdb18c89_Vavrova-Photography-105-von-250.avif',
  '/images/68f68f49083ef945245f7dbd_Vavrova-Photography-68-von-284.avif',
  '/images/6901d149a95c48ea51e96e4c_Vavrova-Photography-63-von-330.avif',
  '/images/68f68f4952e4761f0c43db9f_vavrova-photography-140-von-284-1.avif',
];

const heroImg = bilderList.length > 0
  ? getBildUrl(e, bilderList[0])
  : placeholders[0];

const galleryImgs = bilderList.length > 0
  ? bilderList.map(b => ({ src: getBildUrl(e, b), placeholder: false }))
  : placeholders.map(p => ({ src: p, placeholder: true }));
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={heroImg} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Patricia Bachmann Kindergartenfotografie" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={heroImg} />
  <link rel="icon" href="/images/68f693e4a34b49b0779b4f31_favicon-32x32.png" type="image/png" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": title,
    "serviceType": isKita ? "Kindergartenfotografie" : "Schulfotografie",
    "description": description,
    "image": heroImg,
    "provider": {
      "@type": "LocalBusiness",
      "@id": "https://www.patricia-bachmann.de/#business"
    },
    "areaServed": {
      "@type": "City",
      "name": e.ort
    },
    "url": canonical
  })} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://www.patricia-bachmann.de" },
      { "@type": "ListItem", "position": 2, "name": "Kindergartenfotografie", "item": "https://www.patricia-bachmann.de/kindergartenfotografie" },
      { "@type": "ListItem", "position": 3, "name": e.name, "item": canonical }
    ]
  })} />
</head>
<body>
  <Nav />

  <!-- ── Hero ── -->
  <section class="einrichtung-hero">
    <div class="padding-global">
      <div class="container-large einrichtung-hero__inner">
        <div class="einrichtung-hero__text">
          <div class="eyebrow margin-bottom margin-xsmall">
            <div class="eyebrow-bg"></div>
            <p class="text-style-tagline">{isKita ? 'Kindergartenfotografie' : 'Schulfotografie'}</p>
          </div>
          <h1 class="heading-style-h1">{e.name}</h1>
          <p class="einrichtung-hero__ort">{e.ort}</p>
          <div class="einrichtung-hero__links">
            <a href={mapsUrl} target="_blank" rel="noopener" class="einrichtung-hero__maps-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Auf Google Maps ansehen
            </a>
          </div>
        </div>
        <div class="einrichtung-hero__img-wrap">
          <img
            src={heroImg}
            alt={`${e.name} – ${isKita ? 'Kindergartenfotografie' : 'Schulfotografie'} von Patricia Bachmann`}
            class="einrichtung-hero__img"
            fetchpriority="high"
            loading="eager"
          />
          {bilderList.length === 0 && (
            <div class="einrichtung-hero__placeholder-badge">Beispielfoto</div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Beschreibung ── -->
  {e.beschreibung && (
    <section class="einrichtung-text padding-section-large">
      <div class="padding-global">
        <div class="container-large einrichtung-text__inner" set:html={e.beschreibung} />
      </div>
    </section>
  )}

  <!-- ── Galerie ── -->
  <section class="einrichtung-galerie padding-section-large">
    <div class="padding-global">
      <div class="container-large">
        <div class="eyebrow margin-bottom margin-xsmall">
          <div class="eyebrow-bg"></div>
          <p class="text-style-tagline">Einblicke</p>
        </div>
        <h2 class="heading-style-h2">Fotos aus {e.name}</h2>
        {bilderList.length === 0 && (
          <p class="galerie-placeholder-hint">Echte Fotos folgen bald — hier schon mal ein Vorgeschmack.</p>
        )}
        <div class="einrichtung-galerie__grid">
          {galleryImgs.map((img, i) => (
            <div class="einrichtung-galerie__item">
              <img
                src={img.src}
                alt={`${isKita ? 'Kindergartenfoto' : 'Schulfoto'} – ${e.name}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="einrichtung-galerie__bild"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="einrichtung-cta">
    <div class="padding-global">
      <div class="container-large einrichtung-cta__inner">
        <img
          src="/images/68ecf4cfddadf85c6868f082_gopher-autmn.avif"
          alt=""
          class="einrichtung-cta__gopher"
          loading="lazy"
        />
        <h2 class="heading-style-h2">Auch für eure Einrichtung?</h2>
        <p>
          Ihr möchtet natürliche {isKita ? 'Kindergarten' : 'Schul'}fotos eurer Kinder in {e.ort}?
          Ich freue mich auf eure Anfrage!
        </p>
        <div class="einrichtung-cta__buttons">
          <a href="/kontakt" class="button">
            <div class="button--content">
              <span>Verfügbarkeit anfragen</span>
              <img src="/images/68eb6c8d50f03f9535e61da3_patricia-bachman-kindergartenfotografie-goeppingen.avif" alt="" class="button--image" />
            </div>
          </a>
          <a href="/pakete" class="button is-link">Pakete & Preise →</a>
          <a href={isKita ? '/kindergartenfotografie' : '/schulfotografie'} class="button is-link">
            ← Übersicht
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</body>
</html>

<style>
.padding-global { padding-left: var(--pad-x); padding-right: var(--pad-x); }
.container-large { width: 100%; max-width: 80rem; margin: 0 auto; }
.padding-section-large { padding-top: 7rem; padding-bottom: 7rem; }

/* Eyebrow Pills */
.eyebrow { position: relative; display: inline-flex; padding: 0.3rem 0.45rem 0.2375rem 0.5rem; justify-content: center; align-items: center; }
.eyebrow-bg { position: absolute; inset: 0; z-index: 0; border: 0.5px solid #f4b8ce; border-radius: 0.3rem; background-color: rgba(255,198,218,0.16); }
.text-style-tagline { position: relative; z-index: 1; font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #b06080; display: block; }
.margin-bottom { margin-bottom: 1rem; }
.margin-xsmall { margin-bottom: 0.75rem; }

.heading-style-h1 { font-family: var(--font-heading); font-size: clamp(2.4rem,5vw,4rem); letter-spacing:-0.05em; font-weight:400; line-height:1.15; }
.heading-style-h2 { font-family: var(--font-heading); font-size: clamp(1.9rem,4vw,3.25rem); letter-spacing:-0.02em; font-weight:400; line-height:1.2; }
.button { display:inline-flex; align-items:center; gap:0.5rem; border:1px solid var(--color-glacier-dark); background-color:var(--color-glacier); color:var(--color-text); border-radius:10px; padding:0.175rem 0.175rem 0.175rem 1.5rem; font-family:var(--font-body); font-weight:500; text-decoration:none; transition:border-color 0.2s, background-color 0.6s; cursor:pointer; }
.button:hover { background-image: linear-gradient(135deg, #e6eff3, #6b8c9e); }
.button--content { display:flex; align-items:center; gap:0.5rem; }
.button--image { width:2.25rem; height:2.25rem; border-radius:50%; object-fit:cover; flex-shrink:0; }
.button.is-link { background:none; border:none; padding:0.25rem 0; color: var(--color-text); }
.button.is-link:hover { text-decoration:underline; background-image:none; }

/* ── Hero ── */
.einrichtung-hero {
  background: var(--color-sandy);
  padding-top: clamp(5rem, 10vw, 8rem);
  padding-bottom: clamp(3rem, 6vw, 5rem);
}
.einrichtung-hero__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
.einrichtung-hero__text { display: flex; flex-direction: column; align-items: flex-start; }
.einrichtung-hero__ort {
  color: var(--color-text-mid);
  font-size: 1.1rem;
  margin-top: 0.5rem;
  margin-bottom: 1.5rem;
}
.einrichtung-hero__links { display: flex; gap: 1rem; flex-wrap: wrap; }
.einrichtung-hero__maps-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.875rem;
  color: var(--color-text-mid);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 0.1rem;
  transition: color 0.2s;
}
.einrichtung-hero__maps-link:hover { color: var(--color-text); }
.einrichtung-hero__img-wrap {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  aspect-ratio: 4/3;
}
.einrichtung-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.einrichtung-hero__placeholder-badge {
  position: absolute;
  bottom: 1rem;
  right: 1rem;
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.3rem 0.6rem;
  border-radius: 4px;
}

/* ── Beschreibung ── */
.einrichtung-text { background: var(--color-bg); }
.einrichtung-text__inner {
  max-width: 720px;
  line-height: 1.8;
  color: var(--color-text-mid);
}
.einrichtung-text__inner :global(h2) { font-family: var(--font-heading); font-size: 2rem; font-weight: 400; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--color-text); }
.einrichtung-text__inner :global(p) { margin-bottom: 1rem; }

/* ── Galerie ── */
.einrichtung-galerie { background: var(--color-bg-2); }
.einrichtung-galerie h2 { margin-bottom: 2rem; }
.galerie-placeholder-hint { color: var(--color-text-mid); font-size: 0.9rem; margin-bottom: 1.5rem; }
.einrichtung-galerie__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 1.5rem;
}
.einrichtung-galerie__item { border-radius: 12px; overflow: hidden; }
.einrichtung-galerie__bild { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; transition: transform 0.4s; }
.einrichtung-galerie__item:hover .einrichtung-galerie__bild { transform: scale(1.03); }

/* ── CTA ── */
.einrichtung-cta {
  background: var(--color-bg-2);
  padding: clamp(4rem, 8vw, 6rem) 0;
  text-align: center;
}
.einrichtung-cta__inner { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
.einrichtung-cta__gopher { width: 6rem; }
.einrichtung-cta__inner h2 { margin-bottom: 0.5rem; }
.einrichtung-cta__inner p { color: var(--color-text-mid); max-width: 480px; }
.einrichtung-cta__buttons { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; justify-content: center; }

/* ── Responsive ── */
@media (max-width: 768px) {
  .einrichtung-hero__inner { grid-template-columns: 1fr; gap: 2rem; }
  .einrichtung-hero__img-wrap { order: -1; }
  .einrichtung-galerie__grid { grid-template-columns: repeat(2, 1fr); }
  .padding-section-large { padding-top: 4rem; padding-bottom: 4rem; }
}
@media (max-width: 480px) {
  .einrichtung-galerie__grid { grid-template-columns: 1fr; }
}
</style>
