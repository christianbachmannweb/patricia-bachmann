---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/ubuntu/400.css';
import '@fontsource-variable/arima';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const content = readFileSync(join(process.cwd(), 'src/data/impressum.html'), 'utf-8');
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Impressum - Patricia Bachmann | Kindergartenfotografin</title>
  <meta name="description" content="Impressum von Patricia Bachmann Kindergartenfotografin aus Göppingen." />
  <link rel="canonical" href="https://www.patricia-bachmann.de/impressum" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/images/68f693e4a34b49b0779b4f31_favicon-32x32.png" type="image/png" />
  <script defer data-domain="patricia-bachmann.de" src="https://plausible.polizen.app/js/script.js"></script>
</head>
<body>
  <Nav />
  <main class="legal-page padding-section-large">
    <div class="padding-global">
      <div class="container-large">
        <div class="legal-content" set:html={content} />
      </div>
    </div>
  </main>
  <Footer />
</body>
</html>

<style>
.padding-global { padding-left: var(--pad-x); padding-right: var(--pad-x); }
.container-large { width: 100%; max-width: 80rem; margin: 0 auto; }
.padding-section-large { padding-top: 5rem; padding-bottom: 5rem; }
.legal-page { background: var(--color-bg); }
.legal-content { max-width: 720px; line-height: 1.8; }
.legal-content :global(h1) { font-family: var(--font-heading); font-size: clamp(2rem,4vw,3rem); font-weight:400; margin-bottom:2rem; }
.legal-content :global(h2) { font-family: var(--font-heading); font-size: 1.5rem; font-weight:400; margin-top:2rem; margin-bottom:0.5rem; }
.legal-content :global(p) { color: var(--color-text-mid); margin-bottom:0.75rem; }
.legal-content :global(a) { color: var(--color-text); text-decoration:underline; }
</style>
