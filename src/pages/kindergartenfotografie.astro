---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import FAQ from '../components/FAQ.astro';
import '../styles/global.css';
import '@fontsource/ubuntu/400.css';
import '@fontsource/ubuntu/500.css';
import '@fontsource/ubuntu/700.css';
import '@fontsource-variable/arima';

const testimonials = [
  {
    name: 'Verena Schneider',
    role: 'Kindergartenleiterin',
    quote: 'Einfach wunderschöne Fotos und ein liebevoller Umgang mit den Kindergarten Kindern! Vielen Dank ❤️❤️❤️',
    avatar: '/images/testimonials/68f0ed8cb62e9a388777ee99_verena-schneider-image.png',
    rating: 5,
  },
  {
    name: 'Lena Braun',
    role: 'Erzieherin',
    quote: 'Patricia hat wunderschöne Bilder von den Kindergartenkindern gemacht – man sieht direkt dass so viel Liebe im Detail steckt.',
    avatar: '/images/testimonials/68f0ed4e2c9e5f3d70664147_lena-braun.png',
    rating: 5,
  },
  {
    name: 'Sunny Rose',
    role: 'Mutter',
    quote: 'Super nette Fotografin, die Kinder hatten viel Spaß und die Bilder sind wunderschön!',
    avatar: '/images/testimonials/68f0ecd8cba6bac20da4b94a_sunny-rose-image.png',
    rating: 5,
  },
  {
    name: 'Mia Kächelin',
    role: 'Mutter',
    quote: 'Wir sind einfach begeistert! Patricia ist eine unglaublich liebevolle und einfühlsame Fotografin – genau das, was man sich für Kinderfotos wünscht.',
    avatar: '/images/testimonials/68f0eb41d86cfd97ef28bd27_unnamed.png',
    rating: 5,
  },
  {
    name: 'Julia Hahn',
    role: 'Mutter',
    quote: 'Wunderschöne natürliche Bilder meiner Kinder. Sehr empfehlenswert!',
    avatar: '/images/testimonials/68f10ea57cb99c7f7619b756_julia-hahn-image.png',
    rating: 5,
  },
  {
    name: 'Jessica Beier',
    role: 'Erzieherin',
    quote: 'Patricia ist mega lieb und die Kinder haben sie sofort ins Herz geschlossen. Tolle Bilder!',
    avatar: '/images/testimonials/68f10e6b39e9add4d0199e29_jessica-beier-image.png',
    rating: 5,
  },
  {
    name: 'Stefanie Weinmann',
    role: 'Lehrerin',
    quote: 'Patricia hat unglaubliche Arbeit geleistet. Innerhalb von 2 Tagen hat sie 60 Kinder fotografiert. Das Ergebnis war super.',
    avatar: '/images/testimonials/68f10de1bec0cef973370b7f_stefanie-weinmann-google-bild.png',
    rating: 5,
  },
  {
    name: 'Franca Blauss',
    role: 'Mutter',
    quote: 'Liebevolle Fotografin mit tollem Auge für Details. Die Bilder unserer Kinder sind einfach wunderschön!',
    avatar: '/images/testimonials/68f0edbadcfb6794271b7730_Franca-blauss-image.png',
    rating: 5,
  },
];

const faqs = [
  { question: 'Was kostet ein Kindergartenfotograf in Göppingen?', answer: 'Für die Einrichtung entstehen keine Kosten. Eltern zahlen erst, wenn sie die fertigen Bilder gesehen haben und etwas bestellen möchten – kein Vorabgeld, keine Mindestbestellmenge. Die Pakete starten ab 25,50 €.' },
  { question: 'Wie läuft Kindergartenfotografie ohne Umlaufmappe ab?', answer: 'Jedes Kind erhält am Fototag einen persönlichen QR-Code. Eltern scannen ihn und sehen die Fotos ihres Kindes in einem sicheren Online-Portal. Dort können sie Prints oder Digital-Pakete bestellen – ganz ohne Papierkram und Vorabgeld.' },
  { question: 'Sind Kindergartenfotos DSGVO-konform?', answer: 'Ja. Ich arbeite ausschließlich über Fotograf.de – eine deutsche Plattform mit Servern in Deutschland, sicherer Zahlungsabwicklung und vollständiger DSGVO-Konformität. Einrichtungen und Eltern müssen sich keine Gedanken über Datenschutz machen.' },
  { question: 'Wann bekommen Eltern die Bilder?', answer: 'In der Regel sind die Bilder ca. 2 Wochen nach dem Fototag online verfügbar. Eltern erhalten eine Benachrichtigung und können ihre Bestellung dann bequem von zu Hause aufgeben.' },
  { question: 'Wie bereiten wir als Kindergarten uns auf den Fototag vor?', answer: 'Kaum Aufwand: Ich bringe alles mit – Set-Up, Technik und Accessoires. Im Vorfeld erhaltet ihr einen kurzen Fototag-Guide. Am Tag selbst ist es hilfreich, wenn eine Erzieherin oder ein Erzieher den Ablauf koordiniert.' },
];

const heroImages = [
  '6901d36ddf64124568a0ca7a_vavrova-photography-138-3.avif',
  '6901d36f04c20ac7dc14b02e_vavrova-photography-64-von-330.avif',
  '6901d36d5d887a52ad888ff5_vavrova-photography-140-2.avif',
  '6901d1e9c1b15448359c947f_madi-13.avif',
  '6901d36ff503918c7a0c3276_vavrova-photography-73-von-330.avif',
  '6901d3703b687b2e5af29995_vavrova-photography-164-von-285.avif',
  '6901d36d38ee12a28599286f_madi-19-1.avif',
  '6901d36db64f6528c284a3af_vavrova-photography-139-4.avif',
];
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Kita-Fotograf Göppingen – Kindergartenfotografie | Patricia Bachmann</title>
  <meta name="description" content="Natürliche Kita-Fotos in Göppingen & Umgebung. Ohne Umlaufmappe, DSGVO-konform, online bestellbar – für Einrichtungen kostenlos. Jetzt Verfügbarkeit anfragen!" />
  <link rel="canonical" href="https://www.patricia-bachmann.de/kindergartenfotografie" />
  <meta name="robots" content="index, follow" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.patricia-bachmann.de/kindergartenfotografie" />
  <meta property="og:title" content="Kita-Fotograf Göppingen – Kindergartenfotografie | Patricia Bachmann" />
  <meta property="og:description" content="Natürliche Kita-Fotos in Göppingen & Umgebung. Ohne Umlaufmappe, DSGVO-konform, online bestellbar – für Einrichtungen kostenlos." />
