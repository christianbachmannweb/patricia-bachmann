                </div>
                <div class="startseite_hero-header-sektion_image-wrapper">
                  <img src="/images/68f5d97b3968f7e36a1e0dd4_Vavrova-Photography-16.avif" alt="Kindergartenfoto" class="startseite_hero-header-sektion_image" loading="lazy" />
                </div>
                <div class="startseite_hero-header-sektion_image-wrapper">
                  <img src="/images/68f68f4a2cb959ad0eeeaa3b_Vavrova-Photography-6-von-132.avif" alt="Kindergartenfoto" class="startseite_hero-header-sektion_image" loading="lazy" />
                </div>
                <div class="startseite_hero-header-sektion_image-wrapper">
                  <img src="/images/68f5d97939e52d48a09e9e31_Vavrova-Photography-86-von-452.avif" alt="Kindergartenfoto" class="startseite_hero-header-sektion_image" loading="lazy" />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>{/* /component */}
  </div>{/* /hero-section */}

  <!-- ── Vorteile ── -->
  <section class="section_startseite_vorteile-sektion padding-section-large">
    <div class="section-cloud-top" aria-hidden="true">
