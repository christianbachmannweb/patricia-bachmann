const stripImages = [
  '68f5d97f50a691f540134fe5_Vavrova_Photography-207.avif',
  '68f5d97ee5fc6b9192115130_Vavrova-Photography-1.avif',
  '68f0b97fb8e5682a0a97cc98_unnamed.avif',
  '68f5d97d8687f0e787a79958_Vavrova-Photography-14.avif',
