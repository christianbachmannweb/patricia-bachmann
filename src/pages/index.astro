          <h2 class="heading-style-h2 scroll-reveal">{t.angebot.heading}</h2>
          <p class="vorteile-sub scroll-reveal">{t.angebot.subtext}</p>
        </div>
        <div class="startseite_vorteile-sektion_row">
          <div class="vorteile-card-wrap scroll-reveal">
