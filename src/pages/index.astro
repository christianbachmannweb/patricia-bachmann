<style>
/* ── Layout ── */
.padding-global { padding-left: var(--pad-x); padding-right: var(--pad-x); }
.container-large { width: 100%; max-width: 80rem; margin: 0 auto; }
.padding-section-large { padding-top: 7rem; padding-bottom: 7rem; }

/* ── Eyebrow Tag ── */
.eyebrow {
  position: relative;
  display: inline-flex;
  padding: 0.3rem 0.45rem 0.2375rem 0.5rem;
  justify-content: center;
  align-items: center;
  margin-bottom: 1rem;
}
.eyebrow-bg {
  position: absolute;
  inset: 0%;
  z-index: 0;
  border-style: solid;
  border-width: 0.5px;
  border-color: #f4b8ce;
  border-radius: 0.3rem;
  background-color: rgba(255, 198, 218, 0.16);
}
.text-style-tagline {
  position: relative;
  z-index: 1;
  display: inline-block;
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #b06080;
  text-decoration: none;
}

/* ── Typography ── */
.heading-style-h1 { font-family: var(--font-heading); font-size: clamp(2.4rem, 5vw, 4rem); letter-spacing: -0.05em; font-weight: 400; line-height: 1.15; }
.heading-style-h2 { font-family: var(--font-heading); font-size: clamp(1.9rem, 4vw, 3.25rem); letter-spacing: -0.02em; font-weight: 400; line-height: 1.2; }
.heading-style-h3 { font-family: var(--font-heading); font-size: clamp(1.6rem, 3vw, 2.75rem); letter-spacing: -0.02em; font-weight: 400; line-height: 1.2; }
.heading-style-h5 { font-family: var(--font-heading); font-size: 1.75rem; font-weight: 300; line-height: 1.4; }
.heading-style-h6 { font-family: var(--font-heading); font-size: 1.375rem; font-weight: 400; line-height: 1.4; }

/* ── Buttons ── */
.button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  border: 1px solid var(--color-glacier-dark);
  background-color: var(--color-glacier);
  color: var(--color-text);
  border-radius: 10px;
  padding: 0.175rem 0.175rem 0.175rem 1.5rem;
  font-family: var(--font-body);
  font-weight: 500;
  text-decoration: none;
  transition: border-color 0.2s, background-color 0.6s;
  cursor: pointer;
}
.button:hover { background-image: linear-gradient(135deg, #e6eff3, #6b8c9e); }
.button--content { display: flex; align-items: center; gap: 0.5rem; }
.button--image { width: 2.25rem; height: 2.25rem; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
.button.is-secondary {
  background-color: transparent;
  border-color: var(--color-text);
  backdrop-filter: blur(10px);
  padding: 0.875rem 1.5rem;
  gap: 0;
}
.button.is-secondary:hover { background-image: none; background-color: rgba(13,12,10,0.05); }
.button.is-link { background: none; border: none; padding: 0.25rem 0; gap: 0; }
.button.is-link:hover { text-decoration: underline; background-image: none; }
.button.is-alternate { background-color: var(--color-text); color: var(--color-white); border-color: transparent; }
.button.is-alternate:hover { background-image: none; background-color: var(--color-text-mid); }
.button-group { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2rem; }

/* ── Hero ── */
.hero-section { background: var(--color-bg); }
.startseite_hero-header-sektion_component { display: flex; flex-direction: column; align-items: center; }

/* Zentrierter Text-Block */
.hero-text-block {
  width: 100%;
  text-align: center;
  padding-top: 5rem;
  padding-bottom: 3rem;
}
.max-width-large { max-width: 48rem; margin: 0 auto; }
.hero-heading-2 {
  font-family: var(--font-heading);
  font-size: 2rem;
  font-weight: 400;
  display: block;
  letter-spacing: 0;
}
.hero-sub { font-size: 1.05rem; color: var(--color-text-mid); margin-top: 1.25rem; line-height: 1.7; }
.button-group.is-center { justify-content: center; margin-top: 1.75rem; }

/* Gopher Wrapper */
.gopher-wrapper {
  position: relative;
  width: 100%;
}
.gopher {
  position: absolute;
  inset: -11% 0% auto 26%;
  width: 5.625rem;
  cursor: pointer;
  transition: top 600ms ease;
}
.gopher:hover { top: -16%; }
.gopher.is-teacher { top: -20%; z-index: -1; cursor: default; }
.gopher.is-teacher:hover { top: -11%; }
/* Wrapper für Teacher-Gopher hinter der ersten Card */
.vorteile-card-wrap { position: relative; isolation: isolate; display: grid; }
@media (max-width: 767px) {
  .gopher { left: 6%; top: -9%; }
  .gopher:active { top: -19%; }
}
@media (max-width: 479px) {
  .gopher { top: -15%; }
  .gopher:hover { top: -26%; }
  .gopher.is-teacher { inset: -16% 0% auto auto; }
}

/* Images Layout */
.startseite_hero-header-sektion_images-layout { width: 100%; overflow: hidden; display: flex; flex-direction: column; gap: 1rem; }
.startseite_hero-header-sektion_image-list-top,
.startseite_hero-header-sektion_image-list-bottom {
  display: flex;
  will-change: transform;
}
.startseite_hero-header-sektion_image-list {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 18rem;
  gap: 1rem;
  flex-shrink: 0;
  padding-right: 1rem;
}
.startseite_hero-header-sektion_image-wrapper {
  border-radius: 8px;
  width: 18rem;
  padding-top: 75%;
  position: relative;
  overflow: hidden;
}
.startseite_hero-header-sektion_image-wrapper.is-quote {
  background-color: #2d2d2d;
}
.zitat--content {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.is-stars-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.25rem;
  text-align: center;
}
.stars { font-size: 1.2rem; color: #f59e0b; }
.quote-text { font-family: var(--font-heading); font-size: 0.8rem; font-style: italic; margin-top: 0.5rem; line-height: 1.4; color: #fff; }
.quote-author { font-size: 0.75rem; color: rgba(255,255,255,0.7); margin-top: 0.5rem; display: block; }
.startseite_hero-header-sektion_image { object-fit: cover; width: 100%; height: 100%; position: absolute; inset: 0; }

/* Hero Scrollstrip */
.startseite_hero-header-sektion_content-bottom { width: 100%; overflow: hidden; margin-top: 1rem; }
.hero-strip { display: flex; gap: 1rem; width: max-content; }
.hero-strip__item { flex-shrink: 0; width: 16rem; height: 12rem; border-radius: 8px; overflow: hidden; }
.hero-strip__image { width: 100%; height: 100%; object-fit: cover; }

/* Cloud-Top Dekoration für Sektionen (responsive Werte aus Webflow-Original) */
.section-cloud-top {
  position: absolute;
  inset: -10% 0% auto;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  line-height: 0;
}
@media screen and (min-width: 1920px) {
  .section-cloud-top { top: -19%; }
}
@media screen and (max-width: 991px) {
  .section-cloud-top { top: -6%; }
}
@media screen and (max-width: 767px) {
  .section-cloud-top { top: -4%; }
}
@media screen and (max-width: 479px) {
  .section-cloud-top { top: -2%; }
}
/* Inhalt muss über der Cloud liegen */
.section_startseite_vorteile-sektion > .padding-global {
  position: relative;
  z-index: 1;
}
.cloud-svg { display: block; width: 100%; color: var(--color-bg-2); }

/* ── Vorteile ── */
.section_startseite_vorteile-sektion { background: var(--color-sandy); position: relative; overflow: clip; }
.vorteile-header { text-align: center; margin-bottom: 3rem; }
.vorteile-sub { color: var(--color-text-mid); max-width: 42rem; margin: 1rem auto 0; }
.startseite_vorteile-sektion_row { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
.startseite_vorteile-sektion_card {
  border: 1px solid var(--color-border);
  border-radius: 16px;
  background-color: #dfebee;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  overflow: hidden;
  transition: box-shadow 0.6s;
}
.startseite_vorteile-sektion_card:hover { box-shadow: 0 2px 13px rgba(0,0,0,0.2); }
.startseite_vorteile-sektion_card-content {
  display: flex;
  padding: 1.5rem;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  min-width: 0;
}
.startseite_vorteile-sektion_card-content h3 { hyphens: auto; overflow-wrap: break-word; }
.card-text { color: var(--color-text-mid); margin-top: 0.75rem; font-size: 0.95rem; }
