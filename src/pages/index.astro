  { src: '68f68f4952e4761f0c43db9f_vavrova-photography-140-von-284-1.avif', alt: 'Portrait Kind', location: 'Kindergarten Ebersbach' },
  { src: '68f68f491fc5d5861ffa4d73_Vavrova-Photography-134-von-284.avif', alt: 'Schulportrait', location: 'Blumhard-Haus' },
