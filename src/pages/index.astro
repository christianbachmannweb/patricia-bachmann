---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Kindergartenfotografie Göppingen – Patricia Bachmann</title>
  <meta name="description" content="Kindergartenfotografie & Schulfotografie in Göppingen – Fotografin für Kitas und Grundschulen. Natürlich, DSGVO-konform, wertvoll für Eltern. Jetzt anfragen!" />
  <link rel="canonical" href="https://www.patricia-bachmann.de/" />
  <meta name="robots" content="index, follow" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.patricia-bachmann.de/" />
  <meta property="og:title" content="Kindergartenfotografie Göppingen – Patricia Bachmann" />
  <meta property="og:description" content="Einfühlsame Kindergarten- & Schulfotografie in Göppingen. Natürliche Kinderfotos – unkompliziert für Erzieher, wertvoll für Eltern." />
  <meta property="og:image" content="https://www.patricia-bachmann.de/images/68f5d97ee5fc6b9192115130_Vavrova-Photography-1.jpg" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Patricia Bachmann Kindergartenfotografie" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Kindergartenfotografie Göppingen – Patricia Bachmann" />
  <meta name="twitter:description" content="Einfühlsame Kindergarten- & Schulfotografie in Göppingen. Natürliche Kinderfotos – unkompliziert für Erzieher, wertvoll für Eltern." />
  <meta name="twitter:image" content="https://www.patricia-bachmann.de/images/68f5d97ee5fc6b9192115130_Vavrova-Photography-1.jpg" />
  <meta name="google-site-verification" content="p85enB7-7BGVJ0IYQjMzalY85wJixLn2NLh7At6xkXc" />
  <link rel="icon" href="/images/68f693e4a34b49b0779b4f31_favicon-32x32.png" type="image/png" />
  <link rel="apple-touch-icon" href="/images/68f6942db4d0e09d8a747738_webclip-patricia-bachmann.png" />
  <!-- Schema: LocalBusiness -->
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "ProfessionalService", "Photographer"],
    "@id": "https://www.patricia-bachmann.de/#business",
    "name": "Patricia Bachmann Kindergarten- & Schulfotografie",
    "description": "Einfühlsame Kindergarten- und Schulfotografie in Göppingen und Umgebung – natürlich, unkompliziert, wertvoll.",
    "url": "https://www.patricia-bachmann.de",
    "telephone": "+4971649152847",
    "email": "hallo@patricia-bachmann.de",
    "image": "https://www.patricia-bachmann.de/images/68f5d97ee5fc6b9192115130_Vavrova-Photography-1.jpg",
    "priceRange": "€€",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Lachgasse 4",
      "addressLocality": "Hattenhofen",
      "addressRegion": "Baden-Württemberg",
      "postalCode": "73110",
      "addressCountry": "DE"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": 48.6675604, "longitude": 9.5809271 },
    "areaServed": [
      {"@type": "City", "name": "Göppingen"},
      {"@type": "City", "name": "Hattenhofen"},
      {"@type": "City", "name": "Stuttgart"},
      {"@type": "City", "name": "Ulm"},
      {"@type": "City", "name": "Esslingen am Neckar"},
      {"@type": "City", "name": "Kirchheim unter Teck"},
      {"@type": "City", "name": "Geislingen an der Steige"},
      {"@type": "City", "name": "Ebersbach an der Fils"},
      {"@type": "City", "name": "Eislingen"},
      {"@type": "City", "name": "Süßen"},
      {"@type": "City", "name": "Schwäbisch Gmünd"}
    ],
    "sameAs": [
      "https://www.instagram.com/kindergartenfotografie_pb/",
      "https://www.facebook.com/patriciabachmannkindergartenfotografie",
      "https://maps.google.com/?cid=5398835118567909112"
    ],
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "5", "reviewCount": "13" },
    "founder": { "@type": "Person", "name": "Patricia Bachmann", "jobTitle": "Kindergarten- & Schulfotografin" }
  })}</script>
  <!-- Schema: FAQPage -->
  <script type="application/ld+json" is:inline set:html={faqSchema} />
  <script type="application/ld+json" is:inline set:html={howToSchema} />
  <script type="application/ld+json" is:inline set:html={siteSchema} />
  <script type="application/ld+json" is:inline set:html={reviewSchema} />
</head>
<body>
  <Nav />

  <!-- ── Hero ── -->
  <div class="hero-section">
    <div class="startseite_hero-header-sektion_component">

      <!-- Zentrierter Text-Block -->
      <div class="hero-text-block padding-global">
        <div class="max-width-large">
          <h1 class="heading-style-h1 scroll-reveal">
            {t.hero.h1}<br />
            <span class="hero-heading-2">{t.hero.h1_sub}</span>
          </h1>
          <p class="hero-sub">{t.hero.subtext}</p>
          <div class="button-group is-center">
            <a href="/kontakt" class="button">
              <div class="button--content">
                <span>{t.hero.button_anfragen}</span>
                <img src="/images/68eb6c8d50f03f9535e61da3_patricia-bachman-kindergartenfotografie-goeppingen.avif" alt="" class="button--image" />
              </div>
            </a>
            <a href="/pakete" class="button is-link">
              <span>{t.hero.button_pakete}</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Bilder + Gopher -->
      <div class="gopher-wrapper">
        <img
          src="/images/68ebdef61d9c0d5c04ed3923_gopher-kindergartenphptography.avif"
          alt=""
          class="gopher"
          loading="eager"
          aria-hidden="true"
        />

        <div class="startseite_hero-header-sektion_images-layout">
          <!-- Reihe 1 (scrollt links) -->
          <div class="startseite_hero-header-sektion_image-list-top" id="hero-grid-top">
            {[0, 1].map(() => (
              <div class="startseite_hero-header-sektion_image-list">
