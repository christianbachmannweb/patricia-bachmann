                <div class="startseite_hero-header-sektion_image-wrapper">
                  <img src="/images/68f5d97ee5fc6b9192115130_Vavrova-Photography-1.avif" alt="Kindergartenfoto" class="startseite_hero-header-sektion_image" loading="lazy" />
                </div>
                <div class="startseite_hero-header-sektion_image-wrapper is-quote">
                  <div class="zitat--content">
                    <div class="is-stars-wrapper">
                      <div class="stars">★★★★★</div>
                      <p class="quote-text">"Wir sind einfach begeistert! Patricia ist eine unglaublich liebevolle und einfühlsame Fotografin – genau das, was man sich für Kinderfotos wünscht. ❤️..."</p>
                      <span class="quote-author">Mia Kächelin</span>
                    </div>
                  </div>
                </div>
                <div class="startseite_hero-header-sektion_image-wrapper">
                  <img src="/images/68f5d97d8687f0e787a79958_Vavrova-Photography-14.avif" alt="Kindergartenfoto" class="startseite_hero-header-sektion_image" loading="lazy" />
                </div>
                <div class="startseite_hero-header-sektion_image-wrapper">
                  <img src="/images/68f5da4bb82fb75b0cb7208a_Vavrova-Photography-72-von-284.avif" alt="Kindergartenfoto" class="startseite_hero-header-sektion_image" loading="lazy" />
                </div>
                <div class="startseite_hero-header-sektion_image-wrapper">
                  <img src="/images/68f5d97e8161d2b06032b8f3_Vavrova_Photography-190.avif" alt="Kindergartenfoto" class="startseite_hero-header-sektion_image" loading="lazy" />
                </div>
              </div>
            ))}
          </div>
          <!-- Reihe 2 (scrollt rechts) -->
          <div class="startseite_hero-header-sektion_image-list-bottom" id="hero-grid-bottom">
            {[0, 1].map(() => (
              <div class="startseite_hero-header-sektion_image-list">
                <div class="startseite_hero-header-sektion_image-wrapper is-quote">
                  <div class="zitat--content">
                    <div class="is-stars-wrapper">
                      <div class="stars">★★★★★</div>
                      <p class="quote-text">"Einfach wunderschöne Fotos und ein liebevoller Umgang mit den Kindergarten Kindern!"</p>
