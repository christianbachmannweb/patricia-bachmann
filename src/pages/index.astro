                  </div>
                </div>
                <div class="startseite_hero-header-sektion_image-wrapper">
                  <img src="/images/68f5d97d08d480a975186c24_Vavrova-Photography-67-von-284.avif" alt="Kindergartenfoto" class="startseite_hero-header-sektion_image" loading="lazy" />
                </div>
                <div class="startseite_hero-header-sektion_image-wrapper">
