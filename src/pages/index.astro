    bio: 'Hey, hast du Lust tolle Erinnerungen zu schaffen und als Fotografin fotografieren? Dann melde dich bei mir.',
    img: '690279f8a3daab57658ff6ed_gopher-ma.avif',
    instagram: null,
    email: 'mailto:hallo@patricia-bachmann.de',
  },
