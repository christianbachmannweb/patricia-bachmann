---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import { getEntry } from 'astro:content';
import '../styles/global.css';

const entry = await getEntry('pages', 'homepage');
const t = entry!.data;

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": (t.faq.fragen as Array<{question: string; answer: string}>).map((f: {question: string; answer: string}) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
});

const howToSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "So komme ich als Kindergartenfotografin in eure Einrichtung",
  "description": "In 4 Schritten zum Fototag – unkompliziert für Erzieher und Eltern.",
  "step": (t.ablauf.schritte as Array<{titel: string; text: string}>).map((s: {titel: string; text: string}, i: number) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": s.titel,
    "text": s.text
  }))
});

const siteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.patricia-bachmann.de/#website",
  "name": "Patricia Bachmann Kindergartenfotografie",
  "url": "https://www.patricia-bachmann.de",
  "inLanguage": "de-DE",
  "publisher": { "@id": "https://www.patricia-bachmann.de/#business" }
});

const reviewSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.patricia-bachmann.de/#business",
  "review": [
    {
      "@type": "Review",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "author": { "@type": "Person", "name": "Stefanie Weinmann" },
      "reviewBody": "Patricia hat unglaubliche Arbeit geleistet. Innerhalb von 2 Tagen hat sie 60 Kinder fotografiert. Das Ergebnis war super. Ich bin von den Bildern mehr als Begeistert. Auch das Feedback von anderen Eltern war durch und durch positiv. Man merkt, dass sie Ihren Job mit Leidenschaft macht. Ich würde sie jederzeit wieder beauftragen."
    },
    {
      "@type": "Review",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "author": { "@type": "Person", "name": "Verena Schneider" },
      "reviewBody": "Einfach wunderschöne Fotos und ein liebevoller Umgang mit den Kindergarten Kindern!"
    }
  ]
});
import '@fontsource/ubuntu/300.css';
import '@fontsource/ubuntu/400.css';
import '@fontsource/ubuntu/500.css';
import '@fontsource/ubuntu/700.css';
import '@fontsource-variable/arima';

const testimonials = [
  {
    name: 'Stefanie Weinmann',
    role: 'Mama',
    quote: 'Patricia hat unglaubliche Arbeit geleistet. Innerhalb von 2 Tagen hat sie 60 Kinder fotografiert. Das Ergebnis war super. Ich bin von den Bildern mehr als Begeistert. Auch das Feedback von anderen Eltern war durch und durch positiv. Man merkt, dass sie Ihren Job mit Leidenschaft macht. Ich würde sie jederzeit wieder beauftragen. Vielen Dank für alles 🫶💕',
