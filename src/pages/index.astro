</style>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

// Scroll Reveals
gsap.utils.toArray<HTMLElement>('.scroll-reveal').forEach(el => {
  gsap.from(el, {
    opacity: 0,
    y: 28,
    duration: 0.75,
    ease: 'power3.out',
    scrollTrigger: { trigger: el, start: 'top 88%' },
  });
});

// Letter-Mask Reveal (Split by Letter + Mask, wie Webflow GSAP)
function splitLetterMask(el: HTMLElement): HTMLElement[] {
  const text = el.textContent || '';
  el.textContent = '';
  const chars: HTMLElement[] = [];
  const words = text.split(' ');
  words.forEach((word, wi) => {
    const wordSpan = document.createElement('span');
    wordSpan.className = 'lm-word';
    for (const ch of word) {
      const mask = document.createElement('span');
      mask.className = 'lm-mask';
      const c = document.createElement('span');
      c.className = 'lm-char';
      c.textContent = ch;
      mask.appendChild(c);
      wordSpan.appendChild(mask);
      chars.push(c);
    }
    el.appendChild(wordSpan);
    if (wi < words.length - 1) el.appendChild(document.createTextNode(' '));
  });
  return chars;
}

gsap.utils.toArray<HTMLElement>('.lm-reveal').forEach(el => {
  const chars = splitLetterMask(el);
  gsap.set(chars, { yPercent: 115 });
  gsap.to(chars, {
    yPercent: 0,
    duration: 0.6,
    ease: 'power3.out',
    stagger: { each: 0.03, from: 'start' },
    scrollTrigger: {
      trigger: el,
      start: 'top 85%',
      toggleActions: 'play none none reverse',
    },
  });
});

// About: Pati-Bild wird beim Reinscrollen sauber gecroppt (Bild zoomt INNERHALB
// seines Rahmens via object-fit:cover + overflow:hidden) — kein Überlappen, keine Verzerrung.
const aboutImgFrame = document.querySelector<HTMLElement>('.startseite_about_image-wrapper');
const aboutImgEl = document.querySelector<HTMLElement>('.startseite_about_image');
if (aboutImgFrame && aboutImgEl) {
  gsap.fromTo(aboutImgEl,
    { scale: 1.45 },
    {
      scale: 1,
      ease: 'none',
      transformOrigin: 'center center',
      scrollTrigger: {
        trigger: aboutImgFrame,
        start: 'top 85%',   // startet, sobald der Bildrahmen in den View kommt
        end: 'top 35%',
        scrub: true,
        invalidateOnRefresh: true,
      },
    }
  );
}

// Hero-Grid-Rows marquee
const heroTop = document.getElementById('hero-grid-top') as HTMLElement;
const heroBottom = document.getElementById('hero-grid-bottom') as HTMLElement;
if (heroTop) {
  gsap.to(heroTop, { x: () => -(heroTop.scrollWidth / 2), duration: 35, ease: 'none', repeat: -1 });
}
if (heroBottom) {
  gsap.fromTo(heroBottom, { x: () => -(heroBottom.scrollWidth / 2) }, { x: 0, duration: 30, ease: 'none', repeat: -1 });
}

// Testimonial slider
const slides = document.querySelectorAll<HTMLElement>('.testimonial-slide');
const dots = document.querySelectorAll<HTMLButtonElement>('.testimonial-dot');
let current = 0;

function goTo(i: number) {
  slides[current].classList.remove('is-active');
  dots[current].classList.remove('is-active');
  current = i;
  slides[current].classList.add('is-active');
  dots[current].classList.add('is-active');
}

dots.forEach((dot, i) => dot.addEventListener('click', () => { clearInterval(timer); goTo(i); }));
document.getElementById('testimonial-prev')?.addEventListener('click', () => { clearInterval(timer); goTo((current - 1 + slides.length) % slides.length); });
document.getElementById('testimonial-next')?.addEventListener('click', () => { clearInterval(timer); goTo((current + 1) % slides.length); });
const timer = setInterval(() => goTo((current + 1) % slides.length), 5000);

// WhatsApp Chat Widget
function toggleChat() {
  const chat = document.getElementById('chatBox') as HTMLElement;
  if (chat) chat.style.display = chat.style.display === 'block' ? 'none' : 'block';
}
function sendToWhatsApp() {
  const msg = (document.getElementById('userMsg') as HTMLInputElement)?.value || 'Hallo 👋';
  window.open(`https://wa.me/4971649152847?text=${encodeURIComponent(msg)}`, '_blank');
}
document.getElementById('wa-toggle-btn')?.addEventListener('click', toggleChat);
document.getElementById('wa-close-btn')?.addEventListener('click', toggleChat);
document.getElementById('wa-send-btn')?.addEventListener('click', sendToWhatsApp);
(document.getElementById('userMsg') as HTMLInputElement)?.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') sendToWhatsApp();
});
</script>
