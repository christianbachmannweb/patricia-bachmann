---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import { getEntry } from 'astro:content';
import '../styles/global.css';
import '@fontsource/ubuntu/400.css';
import '@fontsource/ubuntu/500.css';
import '@fontsource-variable/arima';

const entry = await getEntry('pages', 'hilfe');
const d = entry!.data as {
  intro: { eyebrow: string; heading: string; subtext: string };
  sections: Array<{
    id: string;
    eyebrow: string;
    heading: string;
    faqs: Array<{ question: string; answer: string }>;
  }>;
};

const allFaqs = d.sections.flatMap(s => s.faqs);
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Hilfe & FAQ – Fotograf.de & Bildbestellung | Patricia Bachmann</title>
  <meta name="description" content="Häufige Fragen zu QR-Code, Bildbestellung, Download und Bezahlung bei Patricia Bachmann Kindergartenfotografie. Schnelle Antworten, kein Support-Aufwand." />
  <link rel="canonical" href="https://www.patricia-bachmann.de/hilfe" />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.patricia-bachmann.de/hilfe" />
  <meta property="og:title" content="Hilfe & FAQ – Bildbestellung | Patricia Bachmann" />
  <meta property="og:description" content="Antworten auf häufige Fragen zu QR-Code, Bestellung, Bezahlung und Download bei Patricia Bachmann Kindergartenfotografie." />
  <meta property="og:image" content="https://www.patricia-bachmann.de/images/og-image.jpg" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Patricia Bachmann Kindergartenfotografie" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Hilfe & FAQ – Bildbestellung | Patricia Bachmann" />
  <meta name="twitter:description" content="Antworten auf häufige Fragen zu QR-Code, Bestellung, Bezahlung und Download bei Patricia Bachmann Kindergartenfotografie." />
  <meta name="twitter:image" content="https://www.patricia-bachmann.de/images/og-image.jpg" />
  <link rel="icon" href="/images/68f693e4a34b49b0779b4f31_favicon-32x32.png" type="image/png" />
  <link rel="apple-touch-icon" href="/images/68f6942db4d0e09d8a747738_webclip-patricia-bachmann.png" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": allFaqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer.replace(/<[^>]+>/g, '') }
    }))
  })} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://www.patricia-bachmann.de" },
      { "@type": "ListItem", "position": 2, "name": "Hilfe & FAQ", "item": "https://www.patricia-bachmann.de/hilfe" }
    ]
  })} />
  <script defer data-domain="patricia-bachmann.de" src="https://plausible.polizen.app/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"></script>
  <script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
</head>
<body>
  <Nav />

  <!-- ── Hero ── -->
  <section class="hilfe-hero">
    <div class="padding-global">
      <div class="container-large">
        <div class="eyebrow margin-bottom margin-xsmall">
          <div class="eyebrow-bg"></div>
          <p class="text-style-tagline">{d.intro.eyebrow}</p>
        </div>
        <h1 class="heading-style-h1">{d.intro.heading}</h1>
        <p class="hilfe-hero__sub">{d.intro.subtext}</p>

        <!-- Sprunglinks -->
        <nav class="hilfe-nav" aria-label="Zu Abschnitt springen">
          {d.sections.map(s => (
            <a href={`#${s.id}`} class="hilfe-nav__chip">{s.eyebrow}</a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <!-- ── FAQ Sections ── -->
  {d.sections.map(section => (
    <div id={section.id} class="hilfe-section">
      <div class="hilfe-section__eyebrow padding-global">
        <div class="container-large">
          <div class="eyebrow">
            <div class="eyebrow-bg"></div>
            <p class="text-style-tagline">{section.eyebrow}</p>
          </div>
        </div>
      </div>
      <FAQ
        heading={section.heading}
        faqs={section.faqs}
      />
    </div>
  ))}

  <!-- ── CTA ── -->
  <section class="hilfe-cta">
    <div class="padding-global">
      <div class="container-large hilfe-cta__inner">
        <img
          src="/images/68ecf4cfddadf85c6868f082_gopher-autmn.avif"
          alt=""
          class="hilfe-cta__gopher"
          loading="lazy"
          aria-hidden="true"
        />
        <div>
          <div class="eyebrow margin-bottom margin-xsmall">
            <div class="eyebrow-bg"></div>
            <p class="text-style-tagline">Frage offen?</p>
          </div>
          <h2 class="heading-style-h2">Frage nicht dabei?</h2>
          <p class="hilfe-cta__text">Schreib Patricia direkt – sie antwortet persönlich und schnell.</p>
          <div class="hilfe-cta__buttons">
            <a href="/kontakt" class="button">
              <div class="button--content">
                <span>Nachricht schreiben</span>
                <img src="/images/68eb6c8d50f03f9535e61da3_patricia-bachman-kindergartenfotografie-goeppingen.avif" alt="" class="button--image" />
              </div>
            </a>
            <a href="https://patricia-bachmann.fotograf.de/kunden/login" class="button is-link" target="_blank" rel="noopener">
              <span>Zum Kundenportal →</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</body>
</html>

<style>
.padding-global { padding-left: var(--pad-x); padding-right: var(--pad-x); }
.container-large { width: 100%; max-width: 80rem; margin: 0 auto; }
.eyebrow { position: relative; display: inline-flex; padding: 0.3rem 0.45rem 0.2375rem 0.5rem; justify-content: center; align-items: center; margin-bottom: 1rem; }
.eyebrow-bg { position: absolute; inset: 0; z-index: 0; border: 0.5px solid #f4b8ce; border-radius: 0.3rem; background-color: rgba(255,198,218,0.16); }
.text-style-tagline { position: relative; z-index: 1; font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #b06080; }
.heading-style-h1 { font-family: var(--font-heading); font-size: clamp(2.4rem,5vw,4rem); letter-spacing:-0.05em; font-weight:400; line-height:1.15; }
.heading-style-h2 { font-family: var(--font-heading); font-size: clamp(1.9rem,4vw,3.25rem); letter-spacing:-0.02em; font-weight:400; line-height:1.2; }
.margin-bottom { margin-bottom: 1rem; }
.margin-xsmall { margin-bottom: 0.75rem; }

/* Hero */
.hilfe-hero { background: var(--color-sandy); padding: 7rem var(--pad-x) 5rem; }
.hilfe-hero .padding-global { padding: 0; }
.hilfe-hero .container-large { max-width: 56rem; }
.hilfe-hero__sub { font-size: 1.05rem; color: var(--color-text-mid); line-height: 1.7; margin-top: 1.25rem; margin-bottom: 2.5rem; max-width: 42rem; }

/* Sprunglinks */
.hilfe-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.hilfe-nav__chip {
  display: inline-flex; padding: 0.4rem 1rem; border-radius: 2rem;
  font-size: 0.875rem; font-weight: 500;
  background: rgba(255,255,255,0.6); color: var(--color-text);
  border: 1px solid var(--color-border); text-decoration: none;
  transition: background 0.2s, border-color 0.2s;
  backdrop-filter: blur(4px);
}
.hilfe-nav__chip:hover { background: #fff; border-color: var(--color-glacier-dark); }

/* Section eyebrow spacing */
.hilfe-section { background: var(--color-bg); }
.hilfe-section:nth-child(even) { background: var(--color-bg-2); }
.hilfe-section__eyebrow { padding-top: 4rem; padding-bottom: 0; }

/* CTA */
.hilfe-cta { background: var(--color-bg-2); padding: 6rem 0; }
.hilfe-cta__inner { display: flex; align-items: flex-start; gap: 3rem; }
.hilfe-cta__gopher { width: 6rem; flex-shrink: 0; margin-top: -1rem; }
.hilfe-cta__text { color: var(--color-text-mid); line-height: 1.7; margin-top: 0.5rem; margin-bottom: 1.75rem; }
.hilfe-cta__buttons { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }

.button { display:inline-flex; align-items:center; gap:0.5rem; border:1px solid var(--color-glacier-dark); background-color:var(--color-glacier); color:var(--color-text); border-radius:10px; padding:0.175rem 0.175rem 0.175rem 1.5rem; font-family:var(--font-body); font-weight:500; text-decoration:none; transition:border-color 0.2s, background-color 0.6s; cursor:pointer; }
.button:hover { background-image: linear-gradient(135deg, #e6eff3, #6b8c9e); }
.button--content { display:flex; align-items:center; gap:0.5rem; }
.button--image { width:2.25rem; height:2.25rem; border-radius:50%; object-fit:cover; flex-shrink:0; }
.button.is-link { background:none; border:none; padding:0.25rem 0; }
.button.is-link:hover { text-decoration:underline; background-image:none; }

@media (max-width: 640px) {
  .hilfe-hero { padding: 5rem var(--pad-x) 3.5rem; }
  .hilfe-cta__inner { flex-direction: column; gap: 1.5rem; }
  .hilfe-cta__gopher { width: 4rem; }
}
</style>
