---
import '@fontsource/atkinson-hyperlegible-mono/400.css';
import { featuredEinrichtungen } from '../data/einrichtungen';
---

<footer class="footer15_component">
  <!-- Wolken-Übergang oben -->
  <div class="footer-cloud-top" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 1797 332" fill="none" class="footer-cloud-svg"><ellipse cx="220.364" cy="162.12" rx="60.3546" ry="50.9812" fill="currentColor"/><ellipse cx="280.719" cy="157.557" rx="60.3546" ry="71.334" fill="currentColor"/><ellipse cx="366.286" cy="162.12" rx="60.3546" ry="50.9812" fill="currentColor"/><ellipse cx="401.428" cy="191.566" rx="60.3546" ry="50.9812" fill="currentColor"/><ellipse cx="451.173" cy="159.247" rx="84.8875" ry="69.6439" fill="currentColor"/><ellipse cx="559.432" cy="167.512" rx="72.4365" ry="75.0354" fill="currentColor"/><ellipse cx="633.71" cy="152.789" rx="72.4365" ry="60.3126" fill="currentColor"/><ellipse cx="473.865" cy="219.56" rx="72.4365" ry="60.3126" fill="currentColor"/><ellipse cx="723.992" cy="182.235" rx="92.1234" ry="60.3126" fill="currentColor"/><ellipse cx="823.483" cy="184.434" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="833.412" cy="111.139" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="908.238" cy="115.398" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="915.606" cy="220.286" rx="92.1234" ry="83.3523" fill="currentColor"/><ellipse cx="1201.96" cy="269.533" rx="63.5919" ry="56.4319" fill="currentColor"/><ellipse cx="1206.73" cy="173.077" rx="123.562" ry="96.4562" fill="currentColor"/><ellipse cx="1350.86" cy="176.232" rx="123.562" ry="103.641" fill="currentColor"/><path d="M1552.65 128.807C1552.65 169.31 1514.32 202.145 1467.04 202.145C1419.75 202.145 1381.42 169.31 1381.42 128.807C1381.42 88.303 1419.75 55.4684 1467.04 55.4684C1514.32 55.4684 1552.65 88.303 1552.65 128.807Z" fill="currentColor"/><ellipse cx="1498.72" cy="257.772" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="1578.2" cy="196.195" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="1593.17" cy="136.934" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="1631.68" cy="242.547" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="1007.73" cy="136.934" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="1063.54" cy="76.621" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="1138.37" cy="205.596" rx="92.1234" ry="83.6737" fill="currentColor"/><ellipse cx="1063.54" cy="213.102" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="706.147" cy="140.585" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="584.083" cy="76.621" rx="70.8567" ry="76.168" fill="currentColor"/><ellipse cx="443.938" cy="115.398" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="334.754" cy="106.067" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="213.808" cy="76.621" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="135.534" cy="182.235" rx="92.1234" ry="76.168" fill="currentColor"/><ellipse cx="1710.61" cy="146.948" rx="85.612" ry="73.3383" fill="currentColor"/><ellipse cx="92.8766" cy="96.9092" rx="92.1234" ry="76.168" fill="currentColor"/></svg>
  </div>
  <div class="padding-global">
    <div class="container-large">
      <div class="footer15_top-section">
        <div class="footer15_top-wrapper">

          <!-- Left: Adresse + Social -->
          <div class="footer15_left-wrapper">
            <div class="footer15_details-wrapper">
              <div class="footer15_detail-label">Adresse:</div>
              <div class="footer15_detail-text">
                Patricia Bachmann Kindergartenfotografie<br />
                Inh. Patricia Bachmann<br />
                Lachgasse 4<br />
                73110 Hattenhofen
              </div>
              <div class="footer15_detail-label">Kontakt:</div>
              <div class="footer15_contact-links">
                <a href="tel:071649152847" class="footer15_contact-link">07164 9152847</a>
                <a href="mailto:hallo@patricia-bachmann.de?subject=Anfrage%20f%C3%BCr%20ein%20Kindergartenschooting" class="footer15_contact-link">hallo@patricia-bachmann.de</a>
              </div>
            </div>
            <div class="footer15_social-list">
              <a href="https://www.facebook.com/patriciabachmannkindergartenfotografie" class="footer15_social-link" aria-label="Facebook" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M22 12.0611C22 6.50451 17.5229 2 12 2C6.47715 2 2 6.50451 2 12.0611C2 17.0828 5.65684 21.2452 10.4375 22V14.9694H7.89844V12.0611H10.4375V9.84452C10.4375 7.32296 11.9305 5.93012 14.2146 5.93012C15.3088 5.93012 16.4531 6.12663 16.4531 6.12663V8.60261H15.1922C13.95 8.60261 13.5625 9.37822 13.5625 10.1739V12.0611H16.3359L15.8926 14.9694H13.5625V22C18.3432 21.2452 22 17.083 22 12.0611Z" fill="currentColor"/>
                </svg>
              </a>
              <a href="https://www.instagram.com/kindergartenfotografie_pb/" class="footer15_social-link" aria-label="Instagram" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M16 3H8C5.23858 3 3 5.23858 3 8V16C3 18.7614 5.23858 21 8 21H16C18.7614 21 21 18.7614 21 16V8C21 5.23858 18.7614 3 16 3ZM19.25 16C19.2445 17.7926 17.7926 19.2445 16 19.25H8C6.20735 19.2445 4.75549 17.7926 4.75 16V8C4.75549 6.20735 6.20735 4.75549 8 4.75H16C17.7926 4.75549 19.2445 6.20735 19.25 8V16ZM16.75 8.25C17.3023 8.25 17.75 7.80228 17.75 7.25C17.75 6.69772 17.3023 6.25 16.75 6.25C16.1977 6.25 15.75 6.69772 15.75 7.25C15.75 7.80228 16.1977 8.25 16.75 8.25ZM12 7.5C9.51472 7.5 7.5 9.51472 7.5 12C7.5 14.4853 9.51472 16.5 12 16.5C14.4853 16.5 16.5 14.4853 16.5 12C16.5027 10.8057 16.0294 9.65957 15.1849 8.81508C14.3404 7.97059 13.1943 7.49734 12 7.5ZM9.25 12C9.25 13.5188 10.4812 14.75 12 14.75C13.5188 14.75 14.75 13.5188 14.75 12C14.75 10.4812 13.5188 9.25 12 9.25C10.4812 9.25 9.25 10.4812 9.25 12Z" fill="currentColor"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Right: Link Lists -->
          <div class="footer15_menu-wrapper">
            <div class="footer15_link-list">
              <h2 class="footer15_list-heading">In diesen Einrichtungen war ich schon</h2>
              <div class="footer15_divider"></div>
              {featuredEinrichtungen.map((einrichtung) => (
                <a href={`/kindergartenfotografie/${einrichtung.slug}`} class="footer15_link">
                  {einrichtung.name}
                </a>
              ))}
            </div>
            <div class="footer15_link-list">
              <h2 class="footer15_list-heading">Nützliche Links</h2>
              <div class="footer15_divider"></div>
              <a href="/" class="footer15_link">Startseite</a>
              <a href="/kindergartenfotografie" class="footer15_link">Kindergartenfotografie</a>
              <a href="/schulfotografie" class="footer15_link">Schulfotografie</a>
              <a href="https://patricia-bachmann.fotograf.de/kunden/login" class="footer15_link" target="_blank" rel="noopener">Kundenlogin Fotograf.de</a>
              <a href="/hilfe" class="footer15_link">Hilfe & FAQ</a>
              <a href="/kontakt" class="footer15_link">Kontakt</a>
            </div>
          </div>

        </div>
      </div>

      <!-- Logo + Back to top -->
      <div class="footer15_image-wrapper">
        <img
          src="/images/68eb83ff0107a1f15089c6b7_paticia-bachmann-logo-schwarz.avif"
          alt="Logo von Patricia Bachmann Kindergarten- & Schulfotografin aus Göppingen"
          class="footer15_image"
          loading="lazy"
          width="400"
          height="96"
        />
        <a href="#" class="back-to-top" aria-label="Zurück nach oben">
          <img
            src="/images/68fdfe0b0ff273de8f9d19f1_go-up.avif"
            loading="lazy"
            alt=""
            class="gopher-btt"
          />
        </a>
      </div>

      <!-- Bottom bar -->
      <div class="footer15_bottom-wrapper">
        <div class="footer15_credit-text">
          © 2025 Patricia Bachmann<br />
          Design &amp; Dev. Webagentur Bachmann
        </div>
        <nav class="footer15_legal-list" aria-label="Rechtliches">
          <a href="/datenschutz" class="footer15_legal-link">Datenschutz</a>
          <a href="/impressum" class="footer15_legal-link">Impressum</a>
        </nav>
      </div>

    </div>
  </div>

  <!-- Decorative wave SVG (from Webflow) -->
  <div class="footer15_bg-svg" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1670 300" fill="none" preserveAspectRatio="xMidYMid slice">
      <ellipse cx="92.8766" cy="96.9092" rx="92.1234" ry="76.168" fill="currentColor" opacity="0.15"/>
      <ellipse cx="213.808" cy="76.621" rx="92.1234" ry="76.168" fill="currentColor" opacity="0.12"/>
      <ellipse cx="334.754" cy="106.067" rx="92.1234" ry="76.168" fill="currentColor" opacity="0.1"/>
    </svg>
  </div>
</footer>

<style>
.footer15_component {
  background-color: var(--color-sandy);
  position: relative;
  overflow: clip;
}
@media screen and (max-width: 479px) {
  .footer15_component {
    background-color: var(--color-sandy-dark);
  }
}

.footer-cloud-top {
  position: absolute;
  inset: -10% 0% auto;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  line-height: 0;
}
@media screen and (min-width: 1920px) {
  .footer-cloud-top { top: -19%; }
}
@media screen and (max-width: 991px) {
  .footer-cloud-top { top: -6%; }
}
@media screen and (max-width: 767px) {
  .footer-cloud-top { top: -4%; }
}
@media screen and (max-width: 479px) {
  .footer-cloud-top { top: -2%; }
}
.footer-cloud-svg { display: block; width: 100%; color: var(--color-bg-2); }

.padding-global {
  padding-left: var(--pad-x);
  padding-right: var(--pad-x);
  position: relative;
  z-index: 1;
}

.container-large {
  max-width: 80rem;
  margin: 0 auto;
}

.footer15_top-section {
  padding-top: clamp(3rem, 6vw, 5rem);
  padding-bottom: clamp(2rem, 4vw, 3rem);
}

.footer15_top-wrapper {
  display: grid;
  grid-template-columns: 1fr 0.5fr;
  gap: 4vw;
  align-items: start;
}

.footer15_left-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.footer15_details-wrapper {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.footer15_detail-label {
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 600;
  margin-top: 0.75rem;
}

.footer15_detail-label:first-child { margin-top: 0; }

.footer15_detail-text {
  font-family: var(--font-body);
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--color-text-mid);
}

.footer15_contact-links {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.footer15_contact-link {
  font-family: var(--font-mono);
  font-size: 0.875rem;
  color: var(--color-text);
  text-decoration: underline;
}

.footer15_social-list {
  display: flex;
  gap: 0.75rem;
}

.footer15_social-link {
  display: flex;
  align-items: center;
  color: var(--color-text);
  opacity: 0.7;
  transition: opacity 0.2s;
}

.footer15_social-link:hover { opacity: 1; }

.footer15_menu-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem 1.5rem;
  align-items: start;
}

.footer15_link-list {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.footer15_list-heading {
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
}

.footer15_divider {
  width: 100%;
  height: 1px;
  background: var(--color-border);
  margin-bottom: 0.75rem;
}

.footer15_link {
  font-family: var(--font-mono);
  font-size: 0.875rem;
  font-weight: 400;
  letter-spacing: -0.01em;
  padding: 0.4rem 0;
  color: var(--color-text);
  text-decoration: none;
  transition: opacity 0.2s;
}

.footer15_link:hover { opacity: 0.6; }

.footer15_image-wrapper {
  width: 100%;
  position: relative;
  padding-bottom: 2rem;
  border-top: 1px solid var(--color-border);
  padding-top: 2rem;
  display: flex;
  justify-content: center;
  align-items: center;
}

.footer15_image {
  width: 100%;
  max-width: 1000px;
  max-height: none;
  height: auto;
  margin: 0 auto;
  display: block;
  opacity: 0.6;
}

.back-to-top {
  position: absolute;
  right: 0;
  bottom: 2rem;
}

.gopher-btt {
  width: 5rem;
  height: auto;
}

.footer15_bottom-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 2rem;
  border-top: 1px solid var(--color-border);
  padding-top: 1.5rem;
  gap: 1rem;
}

.footer15_credit-text {
  font-family: var(--font-body);
  font-size: 0.8rem;
  color: var(--color-text-mid);
  line-height: 1.5;
}

.footer15_legal-list {
  display: flex;
  gap: 1.5rem;
}

.footer15_legal-link {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--color-text);
  text-decoration: underline;
}

.footer15_bg-svg {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  pointer-events: none;
  color: var(--color-sandy-dark);
}

/* Mobile */
@media (max-width: 767px) {
  .footer15_top-wrapper {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .footer15_menu-wrapper {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .footer15_bottom-wrapper {
    flex-direction: column-reverse;
    align-items: flex-start;
  }

  .footer15_legal-list {
    flex-direction: column;
    gap: 0.5rem;
  }
}
</style>
