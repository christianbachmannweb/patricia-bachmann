---
import '@fontsource/atkinson-hyperlegible-mono/300.css';
import ButtonAnfragen from './ButtonAnfragen.astro';
const navLinks = [
  { href: '/kindergartenfotografie', label: 'Kita-Fotografie' },
  { href: '/schulfotografie', label: 'Schulfotografie' },
  { href: '/pakete', label: 'Pakete' },
  { href: '/blog', label: 'Wissenswertes' },
];
const currentPath = Astro.url.pathname;
---

<div
  data-animation="default"
  class="navbar6_component"
  data-collapse="medium"
  role="banner"
  id="nav-bar"
>
  <div class="navbar6_container">
    <a href="/" class:list={['navbar6_logo-link', { 'w--current': currentPath === '/' }]} aria-label="Patricia Bachmann – Startseite">
      <img
        src="/images/68eb83ff0107a1f15089c6b7_paticia-bachmann-logo-schwarz.avif"
        alt="Logo von Patricia Bachmann Kindergarten- & Schulfotografin aus Göppingen"
        class="navbar6_logo"
        width="200"
        height="48"
        fetchpriority="high"
      />
    </a>

    <nav role="navigation" class="navbar6_menu" id="nav-menu" aria-label="Hauptnavigation">
      <div class="navbar6_menu-left">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={['navbar6_link', { 'w--current': currentPath.startsWith(link.href) }]}
          >
            <div class="nav-link--text">{link.label}</div>
          </a>
        ))}
      </div>
      <div class="navbar6_menu-right">
        <ButtonAnfragen label="Verfügbarkeit anfragen" class="nav-cta" />
      </div>
    </nav>

    <button
      class="navbar6_menu-button"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="nav-menu"
      id="nav-burger"
    >
      <div class="menu-icon5">
        <div class="menu-icon1_line-top"></div>
        <div class="menu-icon1_line-middle">
          <div class="menu-icon1_line-middle-inner"></div>
        </div>
        <div class="menu-icon1_line-bottom"></div>
      </div>
    </button>
  </div>
</div>

<style>
.navbar6_component {
  background-color: transparent;
  align-items: center;
  width: 100%;
  min-height: 4.5rem;
  padding-left: 5%;
  padding-right: 5%;
  transition: background-color 0.4s, box-shadow 0.4s;
  display: flex;
  position: sticky;
  top: 0;
  z-index: 100;
}

.navbar6_component.is-scrolled {
  background-color: rgba(255, 252, 249, 0.95);
  backdrop-filter: blur(8px);
  box-shadow: 0 1px 0 var(--color-border);
}

.navbar6_container {
  justify-content: space-between;
  align-items: center;
  width: 100%;
  max-width: 100%;
  height: 100%;
  margin-left: auto;
  margin-right: auto;
  display: flex;
}

.navbar6_logo-link { padding-left: 0; }

.navbar6_logo { height: 3rem; width: auto; }

.navbar6_menu {
  flex: 1;
  justify-content: space-between;
  align-items: center;
  margin-left: 1.5rem;
  display: flex;
}

.navbar6_menu-left {
  display: flex;
  flex-flow: row;
  align-items: center;
  gap: 0;
}

.navbar6_menu-right {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.navbar6_link {
  font-family: var(--font-mono);
  font-weight: 300;
  letter-spacing: -0.02em;
  margin-right: 0.5rem;
  padding: 0.75rem 1rem;
  transition: all 0.3s;
  border-radius: 0.5rem;
  display: inline-flex;
}

.navbar6_link:hover {
  backdrop-filter: blur(5px);
  color: #fffcf9;
  background-color: rgba(42, 42, 42, 0.21);
}

.navbar6_link.w--current {
  color: #fff;
  background-color: rgba(39, 39, 39, 0.69);
  backdrop-filter: blur(5px);
}

.nav-link--text {
  font-size: 0.95rem;
  font-weight: 500;
}

/* CTA Button */
.button {
  display: inline-flex;
  align-items: center;
  background: var(--color-text);
  color: var(--color-white);
  border-radius: 100px;
  overflow: hidden;
  transition: opacity 0.2s;
}

.button:hover { opacity: 0.85; }

.button--content {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem 0.5rem 1.25rem;
}

.button--label {
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 500;
  white-space: nowrap;
}

.button--image {
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

/* Burger Menu */
.navbar6_menu-button {
  display: none;
  padding: 0.5rem;
  background: none;
  border: none;
  cursor: pointer;
  flex-direction: column;
  gap: 5px;
  align-items: center;
  justify-content: center;
}

.menu-icon5 {
  display: flex;
  flex-direction: column;
  gap: 5px;
  width: 24px;
}

.menu-icon1_line-top,
.menu-icon1_line-bottom {
  height: 2px;
  background: var(--color-text);
  border-radius: 2px;
  transition: transform 0.3s, opacity 0.3s;
}

.menu-icon1_line-middle {
  height: 2px;
  background: var(--color-text);
  border-radius: 2px;
  transition: transform 0.3s;
}

.menu-icon1_line-middle-inner {
  height: 2px;
  background: var(--color-text);
  width: 100%;
}

/* Mobile */
@media (max-width: 767px) {
  .navbar6_menu-button { display: flex; }

  .navbar6_menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(255, 252, 249, 0.98);
    backdrop-filter: blur(12px);
    flex-direction: column;
    align-items: stretch;
    padding: 1rem 5% 2rem;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .navbar6_menu.is-open {
    display: flex;
  }

  .navbar6_menu-left {
    flex-direction: column;
    align-items: stretch;
  }

  .navbar6_link {
    padding: 0.875rem 1rem;
    margin-right: 0;
  }

  .navbar6_menu-right {
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
    margin-top: 0.5rem;
  }

  .button--content { padding: 0.625rem 1.25rem; }
}
</style>

<script>
const burger = document.getElementById('nav-burger') as HTMLButtonElement;
const menu = document.getElementById('nav-menu') as HTMLElement;
const nav = document.getElementById('nav-bar') as HTMLElement;

burger?.addEventListener('click', () => {
  const isOpen = menu.classList.toggle('is-open');
  burger.setAttribute('aria-expanded', String(isOpen));
});

// Scroll state
window.addEventListener('scroll', () => {
  nav.classList.toggle('is-scrolled', window.scrollY > 20);
}, { passive: true });

// Close on nav link click (mobile)
menu?.querySelectorAll('a').forEach(link => {
  link.addEventListener('click', () => {
    menu.classList.remove('is-open');
    burger?.setAttribute('aria-expanded', 'false');
  });
});
</script>
